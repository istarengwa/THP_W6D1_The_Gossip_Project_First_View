<div class ='align-middle text-center'>
	<div class="card mt-5 ml-5 mr-5" style="height:300px">
	  <div class="card-body">
	    <h5 class="card-title name"><%= params[:user].first_name %> <%= params[:user].last_name %></h5>
	    <p class="card-title"><strong>Age : </strong> <%= params[:user].age %></p>
	    <p class="card-title"><strong>Ville : </strong><%= params[:city].name %></p>
	    <p class="card-text"> <strong>Biographie :</strong><br/> <%= params[:user].description %></p>
	    <p class="card-text"> <strong>Date d'inscription : </strong><%= params[:user].created_at.strftime("%d/%m/%Y") %></p>
	    <p class="card-text"> <strong>Potin Partagé(s) : </strong><%= params[:nb_gossips] %></p>
	  </div>
	</div>
</div>